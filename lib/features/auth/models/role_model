class Role {
  final int id;
  final String? name;
  final int? createdBy;
  final int? updatedBy;
  final String? description;
  final String? dateCreated;
  final String? dateUpdated;
  final int? company;

  Role({
    required this.id,
    this.name,
    this.createdBy,
    this.updatedBy,
    this.description,
    this.dateCreated,
    this.dateUpdated,
    this.company,
  });

  factory Role.fromMap(Map<String, dynamic> map) => Role(
        id: map['id'] as int,
        name: map['name'] as String?,
        createdBy: map['created_by'] as int?,
        updatedBy: map['updated_by'] as int?,
        description: map['description'] as String?,
        dateCreated: map['date_created'] as String?,
        dateUpdated: map['date_updated'] as String?,
        company: map['company'] as int?,
      );

      @override
      List<Object?> get props => [id, name, createdBy, updatedBy, description, dateCreated, dateUpdated, company];

      @override
      String toString() => 'Role{id: $id, name: $name, createdBy: $createdBy, updatedBy: $updatedBy, description: $description, dateCreated: $dateCreated, dateUpdated: $dateUpdated, company: $company}';

  Map<String, dynamic> toMap() => {
        'id': id,
        'name': name,
        'created_by': createdBy,
        'updated_by': updatedBy,
        'description': description,
        'date_created': dateCreated,
        'date_updated': dateUpdated,
        'company': company,
      };
}
